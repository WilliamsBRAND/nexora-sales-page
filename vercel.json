{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/checkout/thank-you",
      "destination": "/thank-you",
      "permanent": false
    },
    {
      "source": "/checkout/thank-you.html",
      "destination": "/thank-you",
      "permanent": false
    },
    {
      "source": "/marketplace",
      "destination": "https://nexora.tomidewilliams.store",
      "permanent": true
    },
    {
      "source": "/marketplace/:path*",
      "destination": "https://nexora.tomidewilliams.store/:path*",
      "permanent": true
    }
  ]
}
