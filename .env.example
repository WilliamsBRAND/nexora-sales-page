# Copy this file to .env and fill in your real values. Never commit .env.
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY_HERE
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY_HERE
PAYSTACK_AMOUNT_KOBO=666700
PAYSTACK_CURRENCY=NGN
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
SITE_URL=https://nexora.tomidewilliams.com

# Supabase (partner program database)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Admin password for /admin
ADMIN_PASSWORD=CHANGE_ME
